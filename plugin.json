{
  "name": "cf-proxy",
  "version": "1.2.0",
  "title": "CF 过盾代理",
  "desc": "Cloudflare 过盾代理：uTLS 指纹伪装 + HTTP/3 + DNS 优选 + 智能重试。GET /?url=<目标>",
  "author": "zourjke",
  "runtime": "binary",
  "params": "-port 12525",
  "env": {},
  "binaries": {
    "linux": "cf-proxy-linux",
    "win32": "cf-proxy-win.exe",
    "android": "cf-proxy-android"
  },
  "homepage": "https://github.com/zourjke/cf-proxy",
  "installMode": "import",
  "portField": "-port",
  "healthCheck": {
    "type": "http",
    "path": "/health",
    "port": 12525,
    "timeoutMs": 3000
  }
}
